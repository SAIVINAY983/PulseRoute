# ========================================================
# PulseRoute Frontend Environment Configuration (.env.example)
# ========================================================
#
# Copy this file to .env.local for local development.
# In production (e.g., Vercel, Netlify), set these in your hosting dashboard.
#
# NOTE: Only variables prefixed with VITE_ are exposed to the client bundle.
# NEVER put database credentials or JWT secrets in this file.

# Backend API base URL
# Local Development:
VITE_API_BASE=http://localhost:5000

# Production Example:
# VITE_API_BASE=https://api.pulseroute.yourdomain.com
