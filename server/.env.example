# ========================================================
# PulseRoute Backend Environment Configuration (.env.example)
# ========================================================
#
# Copy this file to .env before starting the server.
# Ensure .env is NEVER committed to version control.

# Server listening port (default: 5000)
PORT=5000

# Runtime environment ('development' | 'production')
NODE_ENV=development

# MongoDB Connection String
# Local standalone:
MONGODB_URI=mongodb://127.0.0.1:27017/pulseroute
# Production MongoDB Atlas Example:
# MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.abcde.mongodb.net/pulseroute?retryWrites=true&w=majority

# Secret key for signing and verifying JWT authentication tokens
# In production, use a high-entropy 64+ character random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_secure_random_production_secret_key_minimum_32_chars

# Allowed client origins for CORS (comma-separated for multiple origins)
# Local Development:
CLIENT_ORIGIN=http://localhost:5173
# Production Example:
# CLIENT_ORIGIN=https://pulseroute.yourdomain.com,https://app.pulseroute.yourdomain.com

# Demo operator login fallback toggle
# In development: true (allows login with operator@pulseroute.demo / demo1234)
# In production: Set to 'false' to enforce strict database-backed user authentication only
ALLOW_DEMO_LOGIN=true
